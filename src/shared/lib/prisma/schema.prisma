generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id String @id @default(uuid())

  email    String @unique
  password String

  fullName String @map("full_name")

  role Role @default(USER)

  provider   String?
  providerId String? @map("provider_id")

  isVerified Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart             Cart?
  orders           Order[]
  verificationCode VerificationCode?

  @@index([providerId])
  @@map("users")
}

model Category {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Ingredient {
  id String @id @default(cuid())

  name         String  @unique
  displayName  String? @map("display_name")
  thumbnailUrl String? @map("thumbnail_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  toppings                    Topping[]
  productVariationIngredients ProductVariationIngredient[]
  cartItemRemovedIngredients  CartItemRemovedIngredient[]

  @@map("ingredients")
}

model Topping {
  id String @id @default(cuid())

  ingredientId String     @unique @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices           ToppingPriceBySize[]
  cartItemToppings CartItemTopping[]

  @@map("toppings")
}

model ToppingPriceBySize {
  toppingId String  @map("topping_id")
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  sizeId String @map("size_id")
  size   Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  price Decimal @db.Decimal(10, 2)

  @@unique([toppingId, sizeId])
  @@map("topping_prices_by_size")
}

model Size {
  id String @id @default(cuid())

  name String

  toppingPrices     ToppingPriceBySize[]
  productVariations ProductVariation[]

  @@map("sizes")
}

model Product {
  id String @id @default(cuid())

  name             String
  slug             String        @unique
  description      String?       @db.Text
  imageUrl         String?       @map("image_url")
  status           ProductStatus @default(DEFAULT)
  maxCountPerOrder Int?          @map("max_count_per_order")
  price            Decimal?      @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  traits ProductTraits?

  variations ProductVariation[]

  @@map("products")
}

model ProductTraits {
  productId String  @unique @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  forChildren Boolean @default(false) @map("for_children")
  vegan       Boolean @default(false)
  spicy       Boolean @default(false)

  @@map("product_traits")
}

model ProductVariation {
  id String @id @default(cuid())

  isDefault Boolean @default(false) @map("is_default")

  price    Decimal @db.Decimal(10, 2)
  imageUrl String? @map("image_url")

  sizeId String @map("size_id")
  size   Size   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  foodValue ProductVariationFoodValue?

  ingredients ProductVariationIngredient[]
  cartItems   CartItem[]

  @@map("product_variations")
}

model ProductVariationIngredient {
  ingredientId String     @map("ingredient_id")
  details      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  choiceType ChoiceType @default(NONE) @map("choice_type")
  isBasic    Boolean    @default(false) @map("is_basic")

  variationId String           @map("variation_id")
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@id([variationId, ingredientId])
  @@map("product_variation_ingredients")
}

model ProductVariationFoodValue {
  variationId String           @unique
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  calories      Float
  carbohydrates Float
  fats          Float
  proteins      Float
  weight        Float

  @@map("product_variation_food_values")
}

model Story {
  id String @id @default(cuid())

  previewImageUrl String? @map("preview_image_url")

  createdAt DateTime @default(now()) @map("created_at")

  items StoryItem[]

  @@map("stories")
}

model StoryItem {
  id String @id @default(cuid())

  sourceUrl String @map("source_url")

  createdAt DateTime @default(now()) @map("created_at")

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_items")
}

model Cart {
  id    String @id @default(cuid())
  token String @unique

  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variationId String
  variation   ProductVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  toppings           CartItemTopping[]
  removedIngredients CartItemRemovedIngredient[]

  @@map("cart_items")
}

model CartItemTopping {
  cartItemId String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  toppingId String
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([cartItemId, toppingId])
  @@map("cart_item_toppings")
}

model CartItemRemovedIngredient {
  cartItemId String
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([cartItemId, ingredientId])
  @@map("cart_item_removed_ingredients")
}

model Order {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  totalAmount Decimal     @db.Decimal(10, 2)
  token       String
  paymentId   String?     @map("payment_id")
  status      OrderStatus
  items       Json

  fullName String @map("full_name")
  address  String
  email    String
  phone    String
  comment  String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([phone])
  @@map("orders")
}

model VerificationCode {
  id   String @id @default(cuid())
  code String

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("verification_codes")
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  DEFAULT
  NEW
  HIT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ChoiceType {
  NONE
  SINGLE
  MULTIPLE
}
